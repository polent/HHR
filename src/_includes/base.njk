<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ meta_description }}">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:type" content="profile">
  <meta property="og:title" content="{{ name }} - {{ role }}">
  <meta property="og:description" content="{{ meta_description }}">
  <meta property="og:image" content="https://www.holger-hellinger.de/assets/images/HolgerHellinger640.png">
  <meta property="og:image:width" content="640">
  <meta property="og:image:height" content="640">
  <meta property="og:image:alt" content="Portrait of {{ name }}">
  <meta property="og:url" content="https://www.holger-hellinger.de">
  <meta property="og:site_name" content="{{ name }} - CV">
  <meta property="og:locale" content="de_DE">
  
  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ name }} - {{ role }}">
  <meta name="twitter:description" content="{{ meta_description }}">
  <meta name="twitter:image" content="https://www.holger-hellinger.de/assets/images/HolgerHellinger640.png">
  <meta name="twitter:image:alt" content="Portrait of {{ name }}">
  
  <!-- Additional SEO & Social Meta Tags -->
  <meta name="author" content="{{ name }}">
  <meta name="keywords" content="experience engineering, director, web development, leadership, accessibility, performance">
  <meta name="theme-color" content="#ffffff">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="white">
  
  <!-- Canonical URL -->
  <link rel="canonical" href="https://www.holger-hellinger.de">
  
  <!-- Favicon & Apple Icons -->
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.ico">
  <link rel="apple-touch-icon" href="/assets/images/favicon/apple-touch-icon.png">
  
  <link rel="stylesheet" href="/assets/css/style.css">
  
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Person",
    "name": "{{ name }}",
    "jobTitle": "{{ role }}",
    "url": "https://www.holger-hellinger.de",
    "sameAs": [
      {% for link in links %}"{{ link.url }}"{% if not loop.last %},{% endif %}{% endfor %}
    ],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "{{ contact.location }}"
    },
    "telephone": "{{ contact.phone }}",
    "email": "{{ contact.email }}",
    "worksFor": [
      {% for job in experience %}{
        "@type": "Organization",
        "name": "{{ job.company }}"
      }{% if not loop.last %},{% endif %}{% endfor %}
    ],
    "alumniOf": [
      {% for edu in education %}{
        "@type": "EducationalOrganization",
        "name": "{{ edu.institution }}"
      }{% if not loop.last %},{% endif %}{% endfor %}
    ],
    "knowsAbout": [
      {% for skill in skills %}"{{ skill.name }}"{% if not loop.last %},{% endif %}{% endfor %}
    ]
  }
  </script>
</head>
<body>
  <div class="container">
    
    <!-- Header -->
    <header class="header-main">
      <img 
        class="profile-img"
        alt="Portrait of {{ name }}" 
        width="160" 
        height="160" 
        sizes="160px" 
        src="/assets/images/HolgerHellinger160.png" 
        srcset="
          /assets/images/HolgerHellinger160.png 160w,
          /assets/images/HolgerHellinger320.png 320w,
          /assets/images/HolgerHellinger640.png 640w
        ">
      
      <div class="header-content">
        <h1>{{ name }}</h1>
        <div class="role">{{ role }}</div>
        
        <ul class="contact-list">
          <li>{{ contact.location }}</li>
          <li><a href="tel:{{ contact.phone | replace(' ', '') }}">{{ contact.phone }}</a></li>
          <li><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></li>
        </ul>
      </div>
    </header>

    <!-- Intro / TLDR -->
    <section class="intro-section">
      <div class="tldr">
        {{ tldr }}
      </div>
      <details>
        <summary>More about me</summary>
        <div class="about-content">
          {{ summary | safe }}
        </div>
      </details>
    </section>

    <!-- Main Content Grid -->
    <div class="main-content">
      
      <!-- Left Column: Experience & Education -->
      <main>
        <section id="experience">
          <h2>Work Experience</h2>
          {% for job in experience %}
          <article class="job-item">
            <span class="meta">{{ job.period }}</span>
            <h3>{{ job.role }}</h3>
            <div class="company"><strong>{{ job.company }}</strong></div>
            <p>{{ job.description }}</p>
          </article>
          {% endfor %}
        </section>

        {% if publications %}
        <section id="publications">
          <h2>Publications & Talks</h2>
          <ul class="publications-list">
          {% for pub in publications %}
          <li class="pub-item">
            <h3>{{ pub.title }} <time datetime="{{ pub.year }}" class="meta">{{ pub.year }}</time></h3>
            <p>{{ pub.description }}</p>
            <p><a href="{{ pub.link }}">{{ pub.title }}</a></p>
          </li>
          {% endfor %}
          </ul>
        </section>
        {% endif %}
      </main>

      <!-- Right Column: Skills, Education, Links -->
      <aside>
        <section id="skills">
          <h2>Skills</h2>
          <ul class="skills-list">
            {% for skill in skills %}
            <li class="skill-item">
              <div class="skill-header">
                <span>{{ skill.name }}</span>
                <span>{{ skill.level }}%</span>
              </div>
              <progress class="skill-progress" value="{{ skill.level }}" max="100" aria-label="{{ skill.name }}: {{ skill.level }}% proficiency"></progress>
            </li>
            {% endfor %}
          </ul>
        </section>

        <section id="education">
          <h2>Education</h2>
          {% for edu in education %}
          <div class="edu-item">
            <span class="meta">{{ edu.year }}</span>
            <div><strong>{{ edu.degree }}</strong></div>
            <div>{{ edu.institution }}</div>
          </div>
          {% endfor %}
        </section>

        {% if links %}
        <section id="links">
          <h2>Links</h2>
          <ul class="links-list">
            {% for link in links %}
            <li>
              <a href="{{ link.url }}" target="_blank" rel="noopener" class="link-with-icon">
                {% if link.icon %}
                {{ link.icon | inlineSvg | safe }}
                {% endif %}
                <span class="link-text">{{ link.label }}</span>
              </a>
            </li>
            {% endfor %}
          </ul>
        </section>
        {% endif %}
      </aside>

    </div>
  </div>

  <!-- Open all details elements when printing -->
  <script>
    if (window.matchMedia('print').matches) {
      [...document.querySelectorAll("details")].forEach(detailEl => {
        detailEl.setAttribute("open", true);
      });
    }
  </script>
</body>
</html>
