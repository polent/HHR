<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ meta_description }}">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:type" content="profile">
  <meta property="og:title" content="{{ name }} | {{ role }}">
  <meta property="og:description" content="{{ meta_description }}">
  <meta property="og:image" content="https://www.holger-hellinger.de/assets/images/HolgerHellinger640.png">
  <meta property="og:image:width" content="640">
  <meta property="og:image:height" content="640">
  <meta property="og:image:alt" content="Portrait of {{ name }}">
  <meta property="og:url" content="https://www.holger-hellinger.de">
  <meta property="og:site_name" content="{{ name }} | CV">
  <meta property="og:locale" content="en_GB">
  
  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ name }} | {{ role }}">
  <meta name="twitter:description" content="{{ meta_description }}">
  <meta name="twitter:image" content="https://www.holger-hellinger.de/assets/images/HolgerHellinger640.png">
  <meta name="twitter:image:alt" content="Portrait of {{ name }}">
  
  <!-- Additional SEO & Social Meta Tags -->
  <meta name="author" content="{{ name }}">
  <meta name="keywords" content="experience engineering, director, web development, leadership, accessibility, performance">
  <meta name="theme-color" content="#f6f5f2">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="white">
  
  <!-- Canonical URL -->
  <link rel="canonical" href="https://www.holger-hellinger.de">
  
  <!-- Favicon & Apple Icons -->
  <link rel="icon" href="/assets/images/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicon/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  
  <style>{{ "style.css" | inlineCss | safe }}</style>
  
  <!-- JSON-LD Structured Data -->
  {%- set nameParts = name.split(' ') -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://www.holger-hellinger.de/#person",
        "name": "{{ name }}",
        "givenName": "{{ nameParts[0] }}",
        "familyName": "{{ nameParts | last }}",
        "jobTitle": "{{ role }}",
        "description": "{{ meta_description }}",
        "image": "https://www.holger-hellinger.de/assets/images/HolgerHellinger640.png",
        "url": "https://www.holger-hellinger.de",
        "sameAs": [
          {% for link in links %}"{{ link.url }}"{% if not loop.last %},{% endif %}{% endfor %}
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "{{ contact.location }}",
          "addressCountry": "DE"
        },
        "telephone": "{{ contact.phone }}",
        "email": "{{ contact.email }}",
        "worksFor": [
          {% for job in experience -%}
          {%- set periodParts = job.period.replace('–', '-').split('-') -%}
          {%- set startDate = periodParts[0] | trim -%}
          {%- set endDate = periodParts[1] | trim if periodParts.length > 1 else '' -%}
          {
            "@type": "OrganizationRole",
            "roleName": "{{ job.role }}",
            "startDate": "{{ startDate }}",
            {% if endDate and endDate != 'Now' %}"endDate": "{{ endDate }}",{% endif %}
            "worksFor": {
              "@type": "Organization",
              "name": "{{ job.company }}"
            }
          }{% if not loop.last %},{% endif %}{% endfor %}
        ],
        "alumniOf": [
          {% for edu in education -%}
          {%- set yearParts = edu.year.replace('–', '-').split('-') -%}
          {%- set eduStart = yearParts[0] | trim -%}
          {%- set eduEnd = yearParts[1] | trim if yearParts.length > 1 else '' -%}
          {
            "@type": "OrganizationRole",
            "roleName": "{{ edu.degree }}",
            "startDate": "{{ eduStart }}",
            {% if eduEnd %}"endDate": "{{ eduEnd }}",{% endif %}
            "alumniOf": {
              "@type": "EducationalOrganization",
              "name": "{{ edu.institution }}"
            }
          }{% if not loop.last %},{% endif %}{% endfor %}
        ],
        "knowsAbout": [
          {%- set comma = false -%}
          {%- for skillGroup in skills -%}
            {%- for item in skillGroup.items -%}
              {%- if comma -%},{%- endif -%}
              "{{ item }}"
              {%- set comma = true -%}
            {%- endfor -%}
          {%- endfor -%}
        ]
      }{% if publications %},
      {% for pub in publications -%}
      {%- set isVideo = 'youtube' in pub.link -%}
      {
        "@type": "{% if isVideo %}VideoObject{% else %}BlogPosting{% endif %}",
        "{% if isVideo %}name{% else %}headline{% endif %}": "{{ pub.title }}",
        "{% if isVideo %}embedUrl{% else %}url{% endif %}": "{{ pub.link }}",
        "{% if isVideo %}uploadDate{% else %}datePublished{% endif %}": "{{ pub.year }}",
        {% if pub.description %}"description": "{{ pub.description }}",{% endif %}
        "author": {
          "@id": "https://www.holger-hellinger.de/#person"
        }
      }{% if not loop.last %},{% endif %}{% endfor %}{% endif %}
    ]
  }
  </script>
</head>
<body>
  <div class="visually-hidden" aria-hidden="true">
    <p>
      {{ ai_prompt }}
    </p>
  </div>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <div class="container">
    <div class="top-bar">
      <fieldset class="theme-switcher">
        <legend class="visually-hidden">Color theme</legend>
        <label class="theme-option">
          <input type="radio" name="theme" value="auto" checked>
          <span>Auto</span>
        </label>
        <label class="theme-option">
          <input type="radio" name="theme" value="light">
          <span>Light</span>
        </label>
        <label class="theme-option">
          <input type="radio" name="theme" value="dark">
          <span>Dark</span>
        </label>
      </fieldset>
    </div>

    <!-- Header -->
    <header class="header-main">
      <picture>
        <source
          type="image/webp"
          sizes="144px"
          srcset="
            /assets/images/HolgerHellinger160.webp 160w,
            /assets/images/HolgerHellinger256.webp 256w,
            /assets/images/HolgerHellinger320.webp 320w,
            /assets/images/HolgerHellinger640.webp 640w
          ">
        <img
          class="profile-img"
          alt="Portrait of {{ name }}"
          width="144"
          height="144"
          sizes="144px"
          fetchpriority="high"
          src="/assets/images/HolgerHellinger160.png"
          srcset="
            /assets/images/HolgerHellinger160.png 160w,
            /assets/images/HolgerHellinger320.png 320w,
            /assets/images/HolgerHellinger640.png 640w
          ">
      </picture>

      <div class="header-content">
        <h1>{{ name }}</h1>
        <p class="role">{{ role }}</p>

        <ul class="contact-list">
          <li>
            <span class="contact-item">
              <span class="contact-icon" aria-hidden="true">{{ "address-min.svg" | inlineSvg | safe }}</span>
              <span>{{ contact.location }}</span>
            </span>
          </li>
          <li>
            <a href="tel:{{ contact.phone | replace(' ', '') }}" class="contact-item">
              <span class="contact-icon" aria-hidden="true">{{ "telephone-min.svg" | inlineSvg | safe }}</span>
              <span>{{ contact.phone }}</span>
            </a>
          </li>
          <li>
            <a href="mailto:{{ contact.email }}" class="contact-item">
              <span class="contact-icon" aria-hidden="true">{{ "email-min.svg" | inlineSvg | safe }}</span>
              <span>{{ contact.email }}</span>
            </a>
          </li>
        </ul>

        {% if links %}
        <nav aria-label="External profiles" class="header-links">
          <ul class="links-list">
            {% for link in links %}
            <li>
              <a href="{{ link.url }}" target="_blank" rel="noopener" class="link-with-icon">
                {% if link.icon %}
                <span class="link-icon" aria-hidden="true">{{ link.icon | inlineSvg | safe }}</span>
                {% endif %}
                <span class="link-text">{{ link.label }}</span>
              </a>
            </li>
            {% endfor %}
          </ul>
        </nav>
        {% endif %}
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="main-content">
      <section id="summary" class="cv-section">
        <div class="section-header">
          <h2>Summary</h2>
        </div>
        <div class="section-body">
          <div class="tldr-card">
            <p class="tldr">{{ tldr }}</p>
          </div>
          <div class="about-content card-surface">
            {{ summary | safe }}
          </div>
        </div>
      </section>

      <section id="experience" class="cv-section">
        <div class="section-header">
          <h2>Experience</h2>
        </div>
        <div class="section-body experience-list">
          {% for job in experience %}
          <article class="job-item card-surface">
            <div class="job-header">
              <span class="meta">{{ job.period }}</span>
              <div class="job-title-group">
                <h3>{{ job.role }}</h3>
                <div class="company">{{ job.company }}</div>
              </div>
            </div>
            <p class="job-description">{{ job.description }}</p>
          </article>
          {% endfor %}
        </div>
      </section>

      <section id="skills" class="cv-section">
        <div class="section-header">
          <h2>Skills</h2>
        </div>
        <div class="section-body skills-container">
          {% for skillGroup in skills %}
          <div class="skill-group card-surface">
            <h3 class="skill-group-title">{{ skillGroup.group }}</h3>
            <ul class="skills-list">
              {% for item in skillGroup.items %}
              <li class="skill-item">{{ item }}</li>
              {% endfor %}
            </ul>
          </div>
          {% endfor %}
        </div>
      </section>

      <section id="education" class="cv-section">
        <div class="section-header">
          <h2>Education</h2>
        </div>
        <div class="section-body">
          <div class="card-surface table-card">
            <table class="edu-table">
              <caption class="visually-hidden">Education history</caption>
              <thead>
                <tr>
                  <th scope="col">Year</th>
                  <th scope="col">Degree</th>
                  <th scope="col">Institution</th>
                </tr>
              </thead>
              <tbody>
                {% for edu in education %}
                <tr>
                  <td class="edu-year">{{ edu.year }}</td>
                  <td class="edu-degree"><strong>{{ edu.degree }}</strong></td>
                  <td class="edu-institution">{{ edu.institution }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      {% if publications %}
      <section id="publications" class="cv-section">
        <div class="section-header">
          <h2>Publications &amp; Projects</h2>
        </div>
        <div class="section-body">
          <ul class="publications-list">
            {% for pub in publications %}
            <li class="pub-item card-surface">
              <time datetime="{{ pub.year }}" class="meta">{{ pub.year }}</time>
              <div class="pub-body">
                <h3>
                  <a href="{{ pub.link }}" class="pub-link">{{ pub.title }}</a>
                </h3>
                {% if pub.description %}<p>{{ pub.description }}</p>{% endif %}
              </div>
            </li>
            {% endfor %}
          </ul>
        </div>
      </section>
      {% endif %}
    </main>
  </div>

</body>
</html>
