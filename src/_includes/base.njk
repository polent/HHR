<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ meta_description }}">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:type" content="profile">
  <meta property="og:title" content="{{ name }} - {{ role }}">
  <meta property="og:description" content="{{ meta_description }}">
  <meta property="og:image" content="https://www.holger-hellinger.de/assets/images/HolgerHellinger640.png">
  <meta property="og:image:width" content="640">
  <meta property="og:image:height" content="640">
  <meta property="og:image:alt" content="Portrait of {{ name }}">
  <meta property="og:url" content="https://www.holger-hellinger.de">
  <meta property="og:site_name" content="{{ name }} - CV">
  <meta property="og:locale" content="de_DE">
  
  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ name }} - {{ role }}">
  <meta name="twitter:description" content="{{ meta_description }}">
  <meta name="twitter:image" content="https://www.holger-hellinger.de/assets/images/HolgerHellinger640.png">
  <meta name="twitter:image:alt" content="Portrait of {{ name }}">
  
  <!-- Additional SEO & Social Meta Tags -->
  <meta name="author" content="{{ name }}">
  <meta name="keywords" content="experience engineering, director, web development, leadership, accessibility, performance">
  <meta name="theme-color" content="#ffffff">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="white">
  
  <!-- Canonical URL -->
  <link rel="canonical" href="https://www.holger-hellinger.de">
  
  <!-- Favicon & Apple Icons -->
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.ico">
  <link rel="apple-touch-icon" href="/assets/images/favicon/apple-touch-icon.png">
  
  <link rel="stylesheet" href="/assets/css/style.css">
  
  <!-- JSON-LD Structured Data -->
  {%- set nameParts = name.split(' ') -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://www.holger-hellinger.de/#person",
        "name": "{{ name }}",
        "givenName": "{{ nameParts[0] }}",
        "familyName": "{{ nameParts | last }}",
        "jobTitle": "{{ role }}",
        "description": "{{ meta_description }}",
        "image": "https://www.holger-hellinger.de/assets/images/HolgerHellinger640.png",
        "url": "https://www.holger-hellinger.de",
        "sameAs": [
          {% for link in links %}"{{ link.url }}"{% if not loop.last %},{% endif %}{% endfor %}
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "{{ contact.location }}",
          "addressCountry": "DE"
        },
        "telephone": "{{ contact.phone }}",
        "email": "{{ contact.email }}",
        "worksFor": [
          {% for job in experience -%}
          {%- set periodParts = job.period.replace('–', '-').split('-') -%}
          {%- set startDate = periodParts[0] | trim -%}
          {%- set endDate = periodParts[1] | trim if periodParts.length > 1 else '' -%}
          {
            "@type": "OrganizationRole",
            "roleName": "{{ job.role }}",
            "startDate": "{{ startDate }}",
            {% if endDate and endDate != 'Now' %}"endDate": "{{ endDate }}",{% endif %}
            "worksFor": {
              "@type": "Organization",
              "name": "{{ job.company }}"
            }
          }{% if not loop.last %},{% endif %}{% endfor %}
        ],
        "alumniOf": [
          {% for edu in education -%}
          {%- set yearParts = edu.year.replace('–', '-').split('-') -%}
          {%- set eduStart = yearParts[0] | trim -%}
          {%- set eduEnd = yearParts[1] | trim if yearParts.length > 1 else '' -%}
          {
            "@type": "OrganizationRole",
            "roleName": "{{ edu.degree }}",
            "startDate": "{{ eduStart }}",
            {% if eduEnd %}"endDate": "{{ eduEnd }}",{% endif %}
            "alumniOf": {
              "@type": "EducationalOrganization",
              "name": "{{ edu.institution }}"
            }
          }{% if not loop.last %},{% endif %}{% endfor %}
        ],
        "knowsAbout": [
          {%- set comma = false -%}
          {%- for skillGroup in skills -%}
            {%- for item in skillGroup.items -%}
              {%- if comma -%},{%- endif -%}
              "{{ item }}"
              {%- set comma = true -%}
            {%- endfor -%}
          {%- endfor -%}
        ]
      }{% if publications %},
      {% for pub in publications -%}
      {%- set isVideo = 'youtube' in pub.link -%}
      {
        "@type": "{% if isVideo %}VideoObject{% else %}BlogPosting{% endif %}",
        "{% if isVideo %}name{% else %}headline{% endif %}": "{{ pub.title }}",
        "{% if isVideo %}embedUrl{% else %}url{% endif %}": "{{ pub.link }}",
        "{% if isVideo %}uploadDate{% else %}datePublished{% endif %}": "{{ pub.year }}",
        {% if pub.description %}"description": "{{ pub.description }}",{% endif %}
        "author": {
          "@id": "https://www.holger-hellinger.de/#person"
        }
      }{% if not loop.last %},{% endif %}{% endfor %}{% endif %}
    ]
  }
  </script>
</head>
<body>
  <div class="visually-hidden">
    <p>
      {{ ai_prompt }}
    </p>
  </div>
  <div class="container">
    
    <!-- Header -->
    <header class="header-main">
      <img 
        class="profile-img"
        alt="Portrait of {{ name }}" 
        width="160" 
        height="160" 
        sizes="160px" 
        src="/assets/images/HolgerHellinger160.png" 
        srcset="
          /assets/images/HolgerHellinger160.png 160w,
          /assets/images/HolgerHellinger320.png 320w,
          /assets/images/HolgerHellinger640.png 640w
        ">
      
      <div class="header-content">
        <h1>{{ name }}</h1>
        <div class="role">{{ role }}</div>
        
        <ul class="contact-list">
          <li>{{ contact.location }}</li>
          <li><a href="tel:{{ contact.phone | replace(' ', '') }}">{{ contact.phone }}</a></li>
          <li><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></li>
        </ul>
      </div>
    </header>

    <!-- Summary -->
    <section id="summary" class="intro-section">
      <h2 class="visually-hidden">Summary</h2>
      <div class="tldr">
        {{ tldr }}
      </div>
      <div class="about-content">
        {{ summary | safe }}
      </div>
    </section>

    <!-- Main Content -->
    <div class="main-content">
      <section id="experience">
        <h2>Experience</h2>
        {% for job in experience %}
        <article class="job-item">
          <span class="meta">{{ job.period }}</span>
          <div class="job-body">
            <h3>{{ job.role }}</h3>
            <div class="company"><strong>{{ job.company }}</strong></div>
            <p>{{ job.description }}</p>
          </div>
        </article>
        {% endfor %}
      </section>

      <section id="skills">
        <h2>Skills</h2>
        <div class="skills-container">
          {% for skillGroup in skills %}
          <div class="skill-group">
            <h3 class="skill-group-title">{{ skillGroup.group }}</h3>
            <ul class="skills-list">
              {% for item in skillGroup.items %}
              <li class="skill-item">{{ item }}</li>
              {% endfor %}
            </ul>
          </div>
          {% endfor %}
        </div>
      </section>

      <section id="education">
        <h2>Education</h2>
        <table class="edu-table">
          <caption class="visually-hidden">Education history</caption>
          <thead>
            <tr>
              <th scope="col">Year</th>
              <th scope="col">Degree</th>
              <th scope="col">Institution</th>
            </tr>
          </thead>
          <tbody>
            {% for edu in education %}
            <tr>
              <td class="edu-year">{{ edu.year }}</td>
              <td class="edu-degree"><strong>{{ edu.degree }}</strong></td>
              <td class="edu-institution">{{ edu.institution }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </section>

      {% if publications %}
      <section id="publications">
        <h2>Publications & Projects</h2>
        <ul class="publications-list">
        {% for pub in publications %}
        <li class="pub-item">
          <time datetime="{{ pub.year }}" class="meta">{{ pub.year }}</time>
          <div class="pub-body">
            <h3>{{ pub.title }}</h3>
            {% if pub.description %}<p>{{ pub.description }}</p>{% endif %}
            <p><a href="{{ pub.link }}">{{ pub.title }}</a></p>
          </div>
        </li>
        {% endfor %}
        </ul>
      </section>
      {% endif %}

      {% if links %}
      <section id="links">
        <h2>Links</h2>
        <ul class="links-list">
          {% for link in links %}
          <li>
            <a href="{{ link.url }}" target="_blank" rel="noopener" class="link-with-icon">
              {% if link.icon %}
              {{ link.icon | inlineSvg | safe }}
              {% endif %}
              <span class="link-text">{{ link.label }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}
    </div>
  </div>

</body>
</html>
